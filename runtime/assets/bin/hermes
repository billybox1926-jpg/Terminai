#!/bin/sh
# Hermes wrapper for TerminAI runtime.
# Uses the bundled Python venv first; falls back to device PATH if absent.
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VENV_PYTHON="$SCRIPT_DIR/hermes-venv/bin/python"

# Try venv python first. Some venvs only expose bin/python3.
for candidate in "$SCRIPT_DIR/hermes-venv/bin/python3" "$VENV_PYTHON"; do
    if [ -x "$candidate" ]; then
        exec "$candidate" -m hermes "$@"
    fi
done

if command -v python3 >/dev/null 2>&1; then
    exec python3 -m hermes "$@"
fi

if command -v python >/dev/null 2>&1; then
    exec python -m hermes "$@"
fi

echo "hermes wrapper: no Python runtime found" >&2
exit 127
