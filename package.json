{
  "name": "terminai",
  "version": "0.1.0",
  "description": "AI-powered local terminal workspace and developer dashboard.",
  "type": "module",
  "bin": {
    "terminai": "scripts/terminai-cli.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "runtime",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/billybox1926-jpg/Terminai.git"
  },
  "homepage": "https://github.com/billybox1926-jpg/Terminai",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run runtime:validate && npm test && npm run build && npm run runtime:status && npm run security:smoke",
    "runtime:bundle": "node scripts/build-runtime-bundle.mjs",
    "runtime:status": "node scripts/runtime-status.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "lint": "npm run typecheck",
    "lint:a11y": "eslint src/**/*.tsx --ext .tsx --max-warnings 0",
    "runtime:validate": "node scripts/validate-runtime-manifests.mjs",
    "test": "vitest run --coverage=false",
    "test:routes": "vitest run --coverage=false",
    "security:smoke": "node scripts/smoke-security.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postcss": "^8.5.15",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.3.2",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/qs": "^6.15.1",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/serve-static": "^2.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "happy-dom": "^14.12.2",
    "jest-axe": "^9.0.0",
    "prettier": "^3.6.2",
    "supertest": "^6.3.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7"
  }
}