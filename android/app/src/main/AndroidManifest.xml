<?xml version="1.0" encoding="utf-8"?>
<!--
  TerminAI Android Manifest
  One app. One dashboard. One runtime.
  Package: com.billybox.terminai
  Not com.termux. Not WebTermux. Not AI Studio.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Minimal permissions for placeholder native host -->
    <!-- VIBRATE: for haptics placeholder -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- INTERNET: for future dashboard/API bridge networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_NETWORK_STATE: for network info -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- POST_NOTIFICATIONS: declared for future runtime permission flow on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Scoped storage strategy: use app-specific storage + optional SAF workspace -->
    <!-- Legacy external storage on Android 9 and below -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- BLOCKED until explicit runtime permission flow exists:
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    -->

    <application
        android:name=".TerminaiApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TerminAI"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TerminAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".dashboard.DashboardActivity"
            android:exported="false"
            android:label="Dashboard"
            android:theme="@style/Theme.TerminAI" />

        <activity
            android:name=".settings.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.TerminAI" />

        <activity
            android:name=".settings.ServerConfigActivity"
            android:exported="false"
            android:label="Server Configuration"
            android:theme="@style/Theme.TerminAI" />

    </application>
</manifest>
